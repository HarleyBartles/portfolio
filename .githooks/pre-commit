#!/usr/bin/env bash
# Regenerate owned mechanical surfaces, then prove the staged product slice.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

AFTER_STATUS=""
BEFORE_STATUS=$(mktemp)
trap 'rm -f "$BEFORE_STATUS" "$AFTER_STATUS"' EXIT
git status --porcelain --untracked-files=all > "$BEFORE_STATUS"

if command -v py >/dev/null 2>&1; then
  PYTHON=(py -3)
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=(python3)
elif command -v python >/dev/null 2>&1; then
  PYTHON=(python)
else
  echo "py, python3, or python not found" >&2
  exit 1
fi

"${PYTHON[@]}" tools/run.py ci --apply --allow-shared-checkout

git add -A -- .agents/skills/ 2>/dev/null || true
git add -- ':(glob)**/INDEX.md' 2>/dev/null || true
git add -- ':(glob)**/INDEX.json' 2>/dev/null || true
git add -- ':(glob)**/.provenance.json' 2>/dev/null || true
git add -- .agents/plugins/marketplace.json 2>/dev/null || true
git add -- codex-marketplace/plugin-roots.json 2>/dev/null || true
git add -- codex-marketplace/manifest.json 2>/dev/null || true

AFTER_STATUS=$(mktemp)
git status --porcelain --untracked-files=all > "$AFTER_STATUS"
UNSTAGED=$(comm -13 <(sort "$BEFORE_STATUS") <(sort "$AFTER_STATUS") | awk 'substr($0,2,1) != " "')
if [ -n "$UNSTAGED" ]; then
  echo "pre-commit: regeneration produced unstaged changes outside its staging allow-list:" >&2
  echo "$UNSTAGED" >&2
  exit 1
fi

"${PYTHON[@]}" tools/run.py precommit --check
