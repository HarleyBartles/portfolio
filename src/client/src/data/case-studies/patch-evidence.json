    {"id": "frame", "name": "Frame", "input": "A bounded story seed.", "decision": "Prove task, failure, Patch action, changed outcome, and audience action.", "output": "A teachable story frame.", "stopCondition": "The metaphor fails to explain the mechanism."},
    {"id": "visual-preproduction", "name": "Visual pre-production", "input": "A teachable story frame.", "decision": "Set world, cast, props, continuity, panel grammar, and production order.", "output": "A reviewed visual plan.", "stopCondition": "The continuity and production choices remain unresolved."},
    {"id": "image-generation-and-qa", "name": "Image generation and QA", "input": "A reviewed visual plan.", "decision": "Inspect candidates and accept only evidence that clears its lane.", "output": "Accepted visual evidence.", "stopCondition": "Character, continuity, or image QA does not clear."},
    {"id": "deterministic-compilation", "name": "Deterministic compilation", "input": "Accepted visual evidence.", "decision": "Build text, layout, captions, and licence material reproducibly.", "output": "An inspectable artefact.", "stopCondition": "The assembled artefact does not preserve the accepted evidence."},
    {"id": "published-artefact-and-receipt", "name": "Published artefact and receipt", "input": "An inspectable artefact.", "decision": "Record provenance, status, source material, transforms, and acceptance.", "output": "A published artefact with a receipt.", "stopCondition": "The public record cannot show what earned publication."}
