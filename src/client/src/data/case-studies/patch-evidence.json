  "inFlight": [
    {"title": "Lawful Heist", "status": "advanced-visual-preproduction", "lesson": "Lawful authority can cross a protected boundary without an invisible bypass.", "currentEvidence": "Six specialists have approved hero, style, and anti-pattern sheets, with a continuity-object sequence.", "remaining": "Comic adaptation, vault and keycard system, safehouse environments, body-slide art, and deck plan remain incomplete."},
    {"title": "Tournament of Reasonable Defaults", "status": "visual-development", "lesson": "Stakeholder analysis and consultation prevent false deliverables.", "currentEvidence": "Character, stakeholder, environment, official, prop, and setup-image packages are present.", "remaining": "Revised scene planning, deck plan, body-image plan, accepted scene art, presentation file, sidecar, QA, and receipts remain."},
    {"title": "Identity Emporium", "status": "visual-development", "lesson": "Role and domain have to agree. Dressing for a job in the office fails; reaching the workplace without adopting the role fails too.", "currentEvidence": "Cowboy makes the pattern easy to see: Bot dresses for the ranch but stays in the office, Bit reaches the ranch and tackles it with ordinary robot methods, while Patch takes the cowboy kit to the cowboy domain. The same structure extends across chef, detective and mechanic, producing four substantial Patch role kits and an approved Bit and Bot role kit.", "remaining": "The adventure still needs a finished narrative and deck, and the provisional Patch role kit packages need their acceptance work completed."}
  ],
  "storyLab": {
    "fairytalePlans": [
      {"title": "The Boy Who Cried Wolf", "lesson": "Preserve escalation signal."},
      {"title": "The Emperor's New Clothes", "lesson": "Agreement can't stand in for evidence."},
      {"title": "Hansel and Gretel", "lesson": "Leave purposeful recovery breadcrumbs."},
      {"title": "The Three Little Pigs", "lesson": "Build resilience before predictable pressure."},
      {"title": "Cinderella", "lesson": "Let temporary authority expire."},
      {"title": "Little Red Riding Hood", "lesson": "Verify identity, provenance, and authority."},
      {"title": "Jack and the Beanstalk", "lesson": "Distinguish technical capability from authorisation."}
    ],
    "adventurePlans": [
      {"title": "Test Goblin", "lesson": "Turn failure-mode suspicion into ranked, executable test scenarios."},
      {"title": "The Tiny Change That Wasn't", "lesson": "Map consumers, tests, migrations, documentation, and operations before treating a small diff as a small blast radius."},
      {"title": "Review Dragon", "lesson": "Shape completed work into a reviewer handoff with intent, risk, evidence, gaps, and requested attention."},
      {"title": "Hall of Mirrors", "lesson": "Separate observation, inference, assumption, contradiction, and uncertainty before proposing a bounded hypothesis and next check."}
    ]
  },
