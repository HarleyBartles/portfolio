#!/usr/bin/env bash
# Regenerate owned mechanical surfaces, then prove the complete staged product.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git exports repository-local variables to hooks. Clear them after resolving
# this worktree so nested Git commands can honour their own working directory.
unset $(git rev-parse --local-env-vars)

# Local Git invokes this hook with the candidate tree in the index and HEAD
# still at its parent. Hosted CI opts into the same state by naming the checked
# out commit. This keeps consumer command selection independent of whether the
# hook was entered by Git or by CI.
HOSTED_COMMIT="${REPO_STANDARDS_HOSTED_COMMIT:-}"
HOSTED_TREE=""
if [ -n "$HOSTED_COMMIT" ]; then
  if git symbolic-ref -q HEAD >/dev/null; then
    echo "pre-commit: hosted parity mode requires a detached checkout" >&2
    exit 1
  fi
  if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-commit: hosted parity mode requires a clean checkout" >&2
    exit 1
  fi
  HOSTED_TREE=$(git rev-parse "$HOSTED_COMMIT^{tree}")
  HOSTED_PARENT=$(git rev-parse "$HOSTED_COMMIT^")
  git reset --soft "$HOSTED_PARENT"
  if [ "$(git write-tree)" != "$HOSTED_TREE" ]; then
    echo "pre-commit: could not reconstruct the hosted commit as a staged snapshot" >&2
    exit 1
  fi
fi
export REPO_STANDARDS_STAGED_SNAPSHOT=1

AFTER_STATUS=""
UNSTAGED_PATCH=$(mktemp)
ORIGINAL_STAGED_PATHS=$(mktemp)
GENERATED_PATHS_FILE=$(mktemp)
UNTRACKED_STASHED=0
WORKTREE_RESET=0
PATCH_RESTORE_FAILED=0

restore_worktree() {
  local exit_code=$?
  trap - EXIT
  if [ "$WORKTREE_RESET" -eq 1 ]; then
    if ! git apply --binary --whitespace=nowarn "$UNSTAGED_PATCH"; then
      echo "pre-commit: validation finished but the unstaged patch could not be restored from $UNSTAGED_PATCH" >&2
      exit_code=1
      PATCH_RESTORE_FAILED=1
    fi
  fi
  if [ "$UNTRACKED_STASHED" -eq 1 ]; then
    if ! git stash pop --quiet; then
      echo "pre-commit: validation finished but untracked files could not be restored; recover them from git stash" >&2
      exit_code=1
    fi
  fi
  rm -f "$AFTER_STATUS"
  rm -f "$GENERATED_PATHS_FILE"
  rm -f "$ORIGINAL_STAGED_PATHS"
  if [ "$PATCH_RESTORE_FAILED" -eq 0 ]; then
    rm -f "$UNSTAGED_PATCH"
  fi
  exit "$exit_code"
}

trap restore_worktree EXIT

# Remember the user's intended paths before apply-mode tools rewrite the staged
# snapshot. Mechanical edits to these paths (for example formatter output) are
# part of the candidate tree; unrelated authored paths remain protected.
git diff --cached --name-only -z > "$ORIGINAL_STAGED_PATHS"

# The public marketplace source is a build input. Never derive installed skills
# from submodule bytes that are absent from the staged gitlink or that do not
# match the commit the superproject index will record.
if ! SUBMODULE_STATUS=$(git submodule status --recursive); then
  echo "pre-commit: could not inspect required submodule source" >&2
  exit 1
fi
SUBMODULE_HEAD_DRIFT=$(printf '%s\n' "$SUBMODULE_STATUS" | grep -E '^[+-U]' || true)
SUBMODULE_WORKTREE_DRIFT=$(git submodule foreach --quiet --recursive '
  actual=$(git rev-parse HEAD) || exit 1
  dirty=$(git status --porcelain --untracked-files=all) || exit 1
  if [ "$actual" != "$sha1" ] || [ -n "$dirty" ]; then
    printf "%s\n" "$displaypath"
  fi
')
if [ -n "$SUBMODULE_HEAD_DRIFT" ] || [ -n "$SUBMODULE_WORKTREE_DRIFT" ]; then
  echo "pre-commit: submodule source does not match the staged gitlink or has uncommitted files:" >&2
  printf '%s\n%s\n' "$SUBMODULE_HEAD_DRIFT" "$SUBMODULE_WORKTREE_DRIFT" >&2
  echo "pre-commit: commit/stage the intended submodule state or restore it before regenerating derived skills" >&2
  exit 1
fi

# Materialize the index in the working tree before regeneration. Every generated
# file and every validation command must observe the snapshot Git will commit,
# never an unstaged repair layered over it.
git diff --binary --no-ext-diff --full-index -- > "$UNSTAGED_PATCH"
if [ -s "$UNSTAGED_PATCH" ]; then
  git checkout -- .
  WORKTREE_RESET=1
fi

if [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git stash push --quiet --keep-index --include-untracked -m "repo-standards pre-commit untracked snapshot $$"
  UNTRACKED_STASHED=1
fi

if command -v py >/dev/null 2>&1; then
  PYTHON=(py -3)
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=(python3)
elif command -v python >/dev/null 2>&1; then
  PYTHON=(python)
else
  echo "py, python3, or python not found" >&2
  exit 1
fi

COMMAND_DECLARATION="$REPO_ROOT/.agents/contracts/repo-standards-commands.json"
if [ ! -f "$COMMAND_DECLARATION" ]; then
  echo "pre-commit: missing consumer command declaration: $COMMAND_DECLARATION" >&2
  exit 1
fi

run_declared() {
  "${PYTHON[@]}" - "$COMMAND_DECLARATION" "$1" "$REPO_ROOT" <<'PY'
import json
import os
import subprocess
import sys
import time

declaration_path, capability, repo_root = sys.argv[1:]
with open(declaration_path, encoding="utf-8") as stream:
    declaration = json.load(stream)
raw = declaration.get(capability)
required_switch = "--apply" if capability == "apply" else "--check"
if capability == "apply":
    if not isinstance(raw, list) or not raw or not all(isinstance(item, str) and item for item in raw):
        raise SystemExit("invalid declared apply command")
    vectors = [raw]
    metadata = [{"name": "apply"}]
else:
    if isinstance(raw, list) and raw and all(isinstance(item, str) and item for item in raw):
        vectors = [raw]
    elif isinstance(raw, list) and raw and all(
        isinstance(vector, list) and vector and all(isinstance(item, str) and item for item in vector)
        for vector in raw
    ):
        vectors = raw
    else:
        raise SystemExit("invalid declared check command")
    metadata = declaration.get("check_metadata")
    if metadata is None:
        metadata = [{"name": f"check {index + 1}"} for index in range(len(vectors))]
    if not isinstance(metadata, list) or len(metadata) != len(vectors) or any(not isinstance(item, dict) for item in metadata):
        raise SystemExit("check_metadata must describe every declared check command")

names = [item.get("name") for item in metadata]
if any(not isinstance(name, str) or not name.strip() for name in names) or len(set(names)) != len(names):
    raise SystemExit("declared checks require unique non-empty names")
for index, (vector, details) in enumerate(zip(vectors, metadata, strict=True)):
    if required_switch not in vector:
        raise SystemExit(f"declared {capability} command is missing {required_switch}")
    dependency = details.get("requires")
    if capability == "check" and dependency is not None:
        if dependency not in names or names.index(dependency) >= index:
            raise SystemExit(f"declared dependency for {names[index]} must name an earlier check")

if capability == "apply":
    command = vectors[0]
    if command[0] == "@python":
        command = [sys.executable, *command[1:]]
    # The hook owns this staged checkout, so its apply phase may regenerate
    # declared surfaces even when Git is using the main worktree or hosted CI.
    if "--allow-shared-checkout" not in command:
        command.append("--allow-shared-checkout")
    raise SystemExit(subprocess.run(command, cwd=repo_root).returncode)

failed = set()
failures = []
skipped = []
for vector, details in zip(vectors, metadata, strict=True):
    name = details["name"]
    dependency = details.get("requires")
    if os.environ.get("REPO_STANDARDS_HOSTED_COMMIT") and details.get("hosted_step"):
        print(f"[pre-commit] DEFER {name}: hosted CI runs it as a separate step", flush=True)
        continue
    if dependency in failed:
        print(f"[pre-commit] SKIP {name}: requires {dependency}", flush=True)
        skipped.append((name, dependency))
        continue
    command = [sys.executable, *vector[1:]] if vector[0] == "@python" else vector
    print(f"[pre-commit] === {name}", flush=True)
    started = time.perf_counter()
    result = subprocess.run(command, cwd=repo_root)
    elapsed = time.perf_counter() - started
    status = "PASS" if result.returncode == 0 else "FAIL"
    stream = sys.stdout if result.returncode == 0 else sys.stderr
    print(f"[pre-commit] {status} {name} ({elapsed:.3f}s)", file=stream, flush=True)
    if result.returncode:
        failed.add(name)
        failures.append(name)

if failures:
    print("[pre-commit] failed checks: " + ", ".join(failures), file=sys.stderr)
    for name, dependency in skipped:
        print(f"[pre-commit] skipped {name}: requires {dependency}", file=sys.stderr)
    raise SystemExit(1)
PY
}

run_declared apply

# Re-stage apply-mode edits only for paths the user had already staged. Update
# the index directly so additions, rewrites, and removals all work in local and
# hosted full-PR snapshots. The NUL-delimited input keeps filenames safe.
git update-index --add --remove -z --stdin < "$ORIGINAL_STAGED_PATHS"

if ! "${PYTHON[@]}" - "$COMMAND_DECLARATION" > "$GENERATED_PATHS_FILE" <<'PY'
import json, pathlib, re, sys
for raw in json.load(open(sys.argv[1], encoding="utf-8"))["generated_paths"]:
    path = raw.replace("\\", "/") if isinstance(raw, str) else ""
    parts = pathlib.PurePosixPath(path).parts if path else ()
    invalid = (
        not path or path in {"*", "**", ".", "./*", "./**"}
        or path.startswith(("/", ":", "!")) or re.match(r"^[A-Za-z]:/", path)
        or ".." in parts or "\x00" in path
    )
    if invalid:
        raise SystemExit(f"invalid generated_paths entry: {raw!r}")
    print(path)
PY
then
  exit 1
fi

while IFS= read -r generated_path; do
  generated_path="${generated_path%$'\r'}"
  [ -n "$generated_path" ] || continue
  case "$generated_path" in
    *'*'*) git add -A -- ":(glob)$generated_path" 2>/dev/null || true ;;
    *) git add -A -- "$generated_path" 2>/dev/null || true ;;
  esac
done < "$GENERATED_PATHS_FILE"

AFTER_STATUS=$(mktemp)
git status --porcelain --untracked-files=all > "$AFTER_STATUS"
UNSTAGED=$(awk 'substr($0,2,1) != " "' "$AFTER_STATUS")
if [ -n "$UNSTAGED" ]; then
  echo "pre-commit: regeneration produced unstaged changes outside its staging allow-list:" >&2
  echo "$UNSTAGED" >&2
  exit 1
fi

# The safety checks above must fail immediately. The validation runner can then
# collect every independent product failure from this exact staged snapshot.
run_declared check

if [ -n "$HOSTED_TREE" ] && [ "$(git write-tree)" != "$HOSTED_TREE" ]; then
  echo "pre-commit: hosted validation changed the committed staged snapshot" >&2
  exit 1
fi
