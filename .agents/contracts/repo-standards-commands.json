{
  "apply": ["@python", "tools/run.py", "ci", "--apply"],
  "check": [
    ["@python", "tools/run.py", "repo-checks", "--check"],
    ["@python", "tools/run.py", "repository-validation", "--check"],
    ["@python", "tools/run.py", "python-tests", "--check"],
    ["@python", "tools/run.py", "vitest-tests", "--check"],
    ["@python", "tools/run.py", "production-build", "--check"],
    ["@python", "tools/run.py", "playwright-tests", "--check"]
  ],
  "check_metadata": [
    {"name": "repository checks"},
    {"name": "repository validation"},
    {"name": "Python tests"},
    {"name": "Vitest tests"},
    {"name": "production build"},
    {"name": "Playwright journeys", "requires": "production build"}
  ],
  "generated_paths": [
    ".agents/skills/**",
    "**/INDEX.md",
    "**/INDEX.json",
    "**/.provenance.json",
    ".agents/plugins/marketplace.json",
    "codex-marketplace/plugin-roots.json",
    "codex-marketplace/manifest.json",
    "src/client/src/data/content/content-manifest.json",
    "src/client/src/data/routes/route-metadata.generated.json",
    "src/client/public/robots.txt",
    "src/client/public/sitemap.xml"
  ]
}
